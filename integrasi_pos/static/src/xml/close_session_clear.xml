<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="point_of_sale.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <!-- Tambahkan kolom Expected kembali -->
        <xpath expr="//tr[@class='text-dark']" position="before">
            <th>Expected</th>
        </xpath>

        <!-- Cash row -->
        <xpath expr="//tr[td[@t-esc='props.default_cash_details.name']]" position="before">
            <td t-esc="env.utils.formatCurrency(state.payments[props.default_cash_details.id]?.expected || 0.0)"/>
        </xpath>

        <!-- Bank rows -->
        <xpath expr="//tr[@t-foreach='props.other_payment_methods']" position="before">
            <td t-esc="env.utils.formatCurrency(state.payments[pm.id]?.expected || 0.0)"/>
        </xpath>
    </t>
</templates>
