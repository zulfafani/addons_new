<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="integrasi_pos_loyalty.PromoPopup" owl="1">
        <div class="popup popup-content">
            <h3 class="popup-title">
                <t t-esc="props.title || 'Available Promotions'"/>
            </h3>
            <div class="promo-list" t-if="props.promotions.length">
                <table class="table table-sm table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Promo</th>
                            <th>Allowed Day</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="props.promotions" t-as="promo" t-key="promo.id">
                            <tr t-on-click="() => applyPromo(promo)" style="cursor: pointer;">
                                <td><t t-esc="promo.name"/></td>
                                <td><t t-esc="promo.allowed_days || '-'"/></td>
                                <td>
                                    <t t-esc="promo.start_time"/> - <t t-esc="promo.end_time"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div t-if="!props.promotions.length">
                <p>No active promotions available.</p>
            </div>
            <div class="footer mt-3 d-flex justify-content-end">
                <button class="btn btn-primary" t-on-click="() => props.close()">OK</button>
            </div>
        </div>
    </t>
</templates>
